# Maintainer: enrell <enrellsa10@proton.me>
pkgname=nebula-bin
_name=nebula
pkgver=0.2.1
pkgrel=1
pkgdesc='Native Qt Quick workspace manager for terminal AI agents (Claude Code, Codex, opencode, ...) - prebuilt binary'
arch=(x86_64)
url='https://github.com/enrell/nebula'
license=(MIT)
depends=(qt6-base qt6-declarative qt6-webengine qt6-webchannel libvterm)
optdepends=('libsecret: store API keys in the system keyring (secret-tool)'
            'claude-code: Claude Code agent and operator'
            'codex: Codex agent and operator'
            'opencode: opencode agent and operator')
provides=(nebula)
conflicts=(nebula nebula-git)
options=(!strip !debug)
source=("$_name-$pkgver-1-x86_64.pkg.tar.zst::https://github.com/enrell/nebula/releases/download/v$pkgver/$_name-$pkgver-1-x86_64.pkg.tar.zst")
sha256sums=('2fcb246d0c38b2331baaf4da4786bb49c44e89d8f2a8d46449ddd3ed099153a3')

package() {
  # repackages the Arch package built by the release workflow (packaging/arch/PKGBUILD)
  cp -a "$srcdir/usr" "$pkgdir/usr"
}
